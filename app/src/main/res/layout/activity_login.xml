<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090D">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_login"
        android:scaleType="centerCrop"
        android:contentDescription="@string/login_background"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="18dp">

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1.2"/>

            <!-- Welcome heading -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Login to continue your journey"
                android:textColor="#E6E6E6"
                android:textSize="15sp"
                android:gravity="center"/>

            <View
                android:layout_width="110dp"
                android:layout_height="3dp"
                android:layout_gravity="center"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/accent_line"/>

            <!-- Email -->

            <EditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/login_input_bg"
                android:paddingStart="20dp"
                android:paddingEnd="18dp"
                android:hint="✉   Email or Phone Number"
                android:textColor="#FFFFFF"
                android:textColorHint="#F0F0F0"
                android:textSize="16sp"
                android:singleLine="true"
                android:inputType="textEmailAddress"/>

            <!-- Password -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/login_input_bg">

                <EditText
                    android:id="@+id/passwordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="65dp"
                    android:background="@android:color/transparent"
                    android:paddingStart="20dp"
                    android:hint="🔒   Password"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#F0F0F0"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:inputType="textPassword"/>

                <TextView
                    android:id="@+id/passwordToggle"
                    android:layout_width="65dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center"
                    android:text="SHOW"
                    android:textColor="#F2C45E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

            </FrameLayout>

            <!-- Remember and forgot password -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/rememberCheckBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#D7B55B"
                    android:text="Remember me"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/forgotPasswordText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password?"
                    android:textColor="#F2C45E"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- Gold login button -->

            <Button
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="35dp"
                android:background="@drawable/button_gold_bg"
                android:backgroundTint="@null"
                android:text="Log In   →"
                android:textAllCaps="false"
                android:textColor="#17120A"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <!-- OR separator -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#99FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="18dp"
                    android:text="OR"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#99FFFFFF"/>

            </LinearLayout>

            <!-- Google login -->

            <TextView
                android:id="@+id/googleButton"
                style="@style/SocialButton"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/social_button_bg"
                android:text="G"
                android:textSize="25sp"
                android:textColor="#FFFFFF"/>

            <!-- Preserved Java IDs for future social login -->

            <TextView
                android:id="@+id/appleButton"
                style="@style/SocialButton"
                android:visibility="gone"
                android:text="Apple"/>

            <TextView
                android:id="@+id/facebookButton"
                style="@style/SocialButton"
                android:visibility="gone"
                android:text="Facebook"/>

            <!-- Sign up -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account?"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/signUpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="Sign Up  →"
                    android:textColor="#F2C45E"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.8"/>

            <!-- Kipchumba ownership signature -->

            <TextView
                android:id="@+id/quickLoginButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="Use fingerprint to access"
                android:textColor="#E8D9B5"
                android:textSize="11sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kipchumba"
                android:textColor="#F2C45E"
                android:textSize="32sp"
                android:textStyle="italic"
                android:gravity="center"/>

            <View
                android:layout_width="65dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="#D7B55B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.35"
                android:text="K I P C H U M B A"
                android:textColor="#F2C45E"
                android:textSize="10sp"
                android:gravity="center"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
