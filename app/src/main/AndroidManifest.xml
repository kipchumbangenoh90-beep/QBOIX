package com.qboix.app;

import android.app.Activity;
import android.content.Intent;
import android.content.SharedPreferences;
import android.graphics.Bitmap;
import android.graphics.BitmapFactory;
import android.graphics.Color;
import android.graphics.drawable.GradientDrawable;
import android.graphics.drawable.ColorDrawable;
import android.os.Bundle;
import android.text.InputType;
import android.text.Spannable;
import android.text.SpannableString;
import android.text.style.ForegroundColorSpan;
import android.view.Gravity;
import android.view.View;
import android.widget.Button;
import android.widget.EditText;
import android.widget.FrameLayout;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.TextView;

import java.io.InputStream;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.SecureRandom;

public class LoginActivity extends Activity {

    // Account data is kept in this app's private storage only (no cloud)
    private static final String PREFS = "qboix_account";
    private static final int MIN_CODE_LENGTH = 4;

    private static final int GOLD = 0xFFD6A64A;
    private static final int CHAMPAGNE = 0xFFFFE4A0;
    private static final int WHITE = 0xFFFFFFFF;
    private static final int MUTED = 0xFFB8BFCC;
    private static final int ERROR = 0xFFFF6B6B;

    private SharedPreferences prefs;
    private boolean creating;
    private TextView title, message;
    private EditText idBox, codeBox, confirmBox;
    private Button actionButton;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        prefs = getSharedPreferences(PREFS, MODE_PRIVATE);
        creating = !prefs.contains("hash");
        buildScreen();
    }

    private void buildScreen() {
        FrameLayout root = new FrameLayout(this);
        root.setBackground(fallbackBackground());

        // Background photo from app/src/main/assets/login_bg.jpg (optional)
        Bitmap photo = loadBackground();
        if (photo != null) {
            ImageView bg = new ImageView(this);
            bg.setImageBitmap(photo);
            bg.setScaleType(ImageView.ScaleType.CENTER_CROP);
            root.addView(bg, new FrameLayout.LayoutParams(
                    FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));
        }

        // Darken the bottom so the card reads clearly
        View shade = new View(this);
        GradientDrawable shadeBg = new GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                new int[]{0x66000000, 0xCC000000});
        shade.setBackground(shadeBg);
        root.addView(shade, new FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));

        LinearLayout column = new LinearLayout(this);
        column.setOrientation(LinearLayout.VERTICAL);
        column.setGravity(Gravity.CENTER_HORIZONTAL);
        column.setPadding(dp(22), dp(40), dp(22), dp(20));
        root.addView(column, new FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));

        // Logo and brand
        ImageView logo = new ImageView(this);
        logo.setImageResource(R.mipmap.ic_launcher);
        column.addView(logo, new LinearLayout.LayoutParams(dp(78), dp(78)));

        TextView brand = new TextView(this);
        brand.setText("Q BOIX");
        brand.setTextColor(CHAMPAGNE);
        brand.setTextSize(30);
        brand.setTypeface(null, android.graphics.Typeface.BOLD);
        brand.setLetterSpacing(0.15f);
        brand.setGravity(Gravity.CENTER);
        brand.setPadding(0, dp(10), 0, 0);
        column.addView(brand);

        TextView tagline = new TextView(this);
        tagline.setText("DESIRE TO ACHIEVE");
        tagline.setTextColor(GOLD);
        tagline.setTextSize(11);
        tagline.setLetterSpacing(0.25f);
        tagline.setGravity(Gravity.CENTER);
        column.addView(tagline);

        // Glass card
        LinearLayout card = new LinearLayout(this);
        card.setOrientation(LinearLayout.VERTICAL);
        card.setGravity(Gravity.CENTER_HORIZONTAL);
        card.setPadding(dp(22), dp(26), dp(22), dp(22));
        GradientDrawable cardBg = new GradientDrawable();
        cardBg.setColor(0xD90B0B0F);
        cardBg.setCornerRadius(dp(28));
        cardBg.setStroke(dp(1), 0x88D6A64A);
        card.setBackground(cardBg);

        LinearLayout.LayoutParams cardLp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
        cardLp.setMargins(0, dp(30), 0, 0);
        column.addView(card, cardLp);

        title = new TextView(this);
        title.setTextSize(24);
        title.setTypeface(null, android.graphics.Typeface.BOLD);
        title.setTextColor(WHITE);
        title.setGravity(Gravity.CENTER);
        card.addView(title);

        TextView sub = new TextView(this);
        sub.setText(creating
                ? "Set up your operator account"
                : "Login to continue your journey");
        sub.setTextColor(MUTED);
        sub.setTextSize(14);
        sub.setGravity(Gravity.CENTER);
        sub.setPadding(0, dp(4), 0, dp(20));
        card.addView(sub);

        setTitleText();

        idBox = field("Operator ID", false);
        card.addView(idBox, fieldParams(0));

        codeBox = field("Access code (at least 4 characters)", true);
        card.addView(codeBox, fieldParams(dp(14)));

        confirmBox = field("Confirm access code", true);
        confirmBox.setVisibility(creating ? View.VISIBLE : View.GONE);
        card.addView(confirmBox, fieldParams(dp(14)));

        actionButton = new Button(this);
        actionButton.setText(creating ? "Create Account  \u2192" : "Log In  \u2192");
        actionButton.setAllCaps(false);
        actionButton.setTextColor(0xFF111113);
        actionButton.setTextSize(16);
        actionButton.setTypeface(null, android.graphics.Typeface.BOLD);
        actionButton.setStateListAnimator(null);
        GradientDrawable btnBg = new GradientDrawable(
                GradientDrawable.Orientation.LEFT_RIGHT,
                new int[]{CHAMPAGNE, GOLD});
        btnBg.setCornerRadius(dp(28));
        actionButton.setBackground(btnBg);
        LinearLayout.LayoutParams bp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, dp(56));
        bp.setMargins(0, dp(24), 0, 0);
        card.addView(actionButton, bp);
        actionButton.setOnClickListener(v -> {
            if (creating) createAccount(); else signIn();
        });

        message = new TextView(this);
        message.setTextColor(MUTED);
        message.setTextSize(13);
        message.setGravity(Gravity.CENTER);
        message.setPadding(0, dp(16), 0, 0);
        message.setText(creating
                ? "Your account is stored only on this phone."
                : "Enter your operator ID and access code.");
        card.addView(message);

        // Footer line
        TextView footer = new TextView(this);
        footer.setText("RUN  \u2022  EXPLORE  \u2022  ACHIEVE");
        footer.setTextColor(GOLD);
        footer.setTextSize(10);
        footer.setLetterSpacing(0.2f);
        footer.setGravity(Gravity.CENTER);
        footer.setPadding(0, dp(22), 0, 0);
        column.addView(footer);

        setContentView(root);
    }

    private void setTitleText() {
        String full = creating ? "Create Account" : "Welcome Back";
        String highlight = creating ? "Account" : "Back";
        SpannableString s = new SpannableString(full);
        int start = full.indexOf(highlight);
        s.setSpan(new ForegroundColorSpan(GOLD), start, start + highlight.length(),
                Spannable.SPAN_EXCLUSIVE_EXCLUSIVE);
        title.setText(s);
    }

    private LinearLayout.LayoutParams fieldParams(int topMargin) {
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, dp(54));
        lp.setMargins(0, topMargin, 0, 0);
        return lp;
    }

    private EditText field(String hint, boolean secret) {
        EditText e = new EditText(this);
        e.setHint(hint);
        e.setHintTextColor(0xFF8F98AB);
        e.setTextColor(WHITE);
        e.setTextSize(16);
        e.setSingleLine(true);
        e.setPadding(dp(20), 0, dp(20), 0);
        GradientDrawable bg = new GradientDrawable();
        bg.setColor(0xCC15151C);
        bg.setCornerRadius(dp(27));
        bg.setStroke(dp(1), 0x66D6A64A);
        e.setBackground(bg);   // replaces the default underline
        if (secret) {
            e.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD);
        } else {
            e.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS);
        }
        return e;
    }

    private void createAccount() {
        String id = idBox.getText().toString().trim().toUpperCase();
        String code = codeBox.getText().toString();
        String confirm = confirmBox.getText().toString();

        if (id.isEmpty()) {
            showError("Enter an operator ID");
            return;
        }
        if (code.length() < MIN_CODE_LENGTH) {
            showError("Access code must be at least 4 characters");
            return;
        }
        if (!code.equals(confirm)) {
            showError("Access codes do not match");
            return;
        }
        try {
            String salt = randomSalt();
            String hash = hash(salt, code);
            prefs.edit()
                    .putString("id", id)
                    .putString("salt", salt)
                    .putString("hash", hash)
                    .apply();
            openBoot(id, "Account created. Welcome, ");
        } catch (Exception e) {
            showError("Could not save the account");
        }
    }

    private void signIn() {
        String id = idBox.getText().toString().trim().toUpperCase();
        String code = codeBox.getText().toString();

        String savedId = prefs.getString("id", "");
        String salt = prefs.getString("salt", "");
        String savedHash = prefs.getString("hash", "");

        if (!id.equals(savedId)) {
            showError("Unknown operator ID");
            return;
        }
        try {
            if (hash(salt, code).equals(savedHash)) {
                openBoot(id, "Welcome back, ");
            } else {
                showError("Access denied");
                codeBox.setText("");
            }
        } catch (Exception e) {
            showError("Sign-in failed");
        }
    }

    private void openBoot(String id, String text) {
        message.setTextColor(CHAMPAGNE);
        message.setText(text + id);
        startActivity(new Intent(this, MainActivity.class));
        finish();
    }

    private void showError(String text) {
        message.setTextColor(ERROR);
        message.setText(text);
    }

    private Bitmap loadBackground() {
        try (InputStream in = getAssets().open("login_bg.jpg")) {
            return BitmapFactory.decodeStream(in);
        } catch (Exception e) {
            return null;
        }
    }

    private GradientDrawable fallbackBackground() {
        return new GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                new int[]{0xFF1B2540, 0xFF05060A});
    }

    private int dp(int v) {
        return Math.round(v * getResources().getDisplayMetrics().density);
    }

    private String randomSalt() {
        byte[] bytes = new byte[16];
        new SecureRandom().nextBytes(bytes);
        return toHex(bytes);
    }

    // SHA-256 of salt and code together. The access code itself is never stored.
    private String hash(String salt, String code) throws Exception {
        MessageDigest md = MessageDigest.getInstance("SHA-256");
        byte[] digest = md.digest((salt + ":" + code).getBytes(StandardCharsets.UTF_8));
        return toHex(digest);
    }

    private String toHex(byte[] bytes) {
        StringBuilder sb = new StringBuilder();
        for (byte b : bytes) {
            sb.append(String.format("%02x", b));
        }
        return sb.toString();
    }
}
